    "PluginSlot": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "backend": {
          "enum": [
            "surge_xt",
            "vst3",
            "builtin",
            "faust"
          ],
          "title": "Backend",
          "type": "string"
        },
        "uri": {
          "description": "ruta del plugin, nombre builtin o código faust",
          "title": "Uri",
          "type": "string"
        },
        "preset": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preset"
        },
        "state": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State"
        },
        "params": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Params",
          "type": "object"
        },
        "bypass": {
          "default": false,
          "title": "Bypass",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "backend",
        "uri"
      ],
      "title": "PluginSlot",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "De dónde salió un asset: herramienta, versión, parámetros, semilla y padres.",
      "properties": {
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "parents": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Parents",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "tool"
      ],
      "title": "Provenance",
      "type": "object"
    },
