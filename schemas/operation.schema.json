    "MeterPointM": {
      "additionalProperties": false,
      "properties": {
        "bar": {
          "minimum": 0,
          "title": "Bar",
          "type": "integer"
        },
        "numerator": {
          "maximum": 32,
          "minimum": 1,
          "title": "Numerator",
          "type": "integer"
        },
        "denominator": {
          "default": 4,
          "enum": [
            1,
            2,
            4,
            8,
            16,
            32
