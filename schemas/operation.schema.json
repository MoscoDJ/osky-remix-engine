      },
      "required": [
        "bar",
        "numerator"
      ],
      "title": "MeterPointM",
      "type": "object"
    },
    "MidiClip": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "midi",
          "default": "midi",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "start_tick": {
          "minimum": 0,
          "title": "Start Tick",
          "type": "integer"
        },
        "length_ticks": {
          "exclusiveMinimum": 0,
          "title": "Length Ticks",
          "type": "integer"
        },
        "notes": {
          "items": {
            "$ref": "#/$defs/MidiNote"
          },
          "title": "Notes",
