{
  "$defs": {
    "AddClip": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "add_clip",
          "default": "add_clip",
          "title": "Op",
          "type": "string"
        },
        "track": {
          "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
          "title": "Track",
          "type": "string"
        },
        "clip": {
          "discriminator": {
            "mapping": {
              "audio": "#/$defs/AudioClip",
              "midi": "#/$defs/MidiClip"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AudioClip"
            },
            {
              "$ref": "#/$defs/MidiClip"
            }
          ],
          "title": "Clip"
        }
      },
      "required": [
        "track",
        "clip"
      ],
      "title": "AddClip",
      "type": "object"
    },
    "AddMarker": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "add_marker",
          "default": "add_marker",
          "title": "Op",
          "type": "string"
        },
        "marker": {
          "$ref": "#/$defs/Marker"
        }
      },
      "required": [
        "marker"
      ],
      "title": "AddMarker",
      "type": "object"
    },
    "AddPlugin": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "add_plugin",
          "default": "add_plugin",
          "title": "Op",
          "type": "string"
        },
        "track": {
          "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
          "title": "Track",
          "type": "string"
        },
        "plugin": {
          "$ref": "#/$defs/PluginSlot"
        },
        "index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Index"
        }
      },
      "required": [
        "track",
        "plugin"
      ],
      "title": "AddPlugin",
      "type": "object"
    },
    "AddSend": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "add_send",
          "default": "add_send",
          "title": "Op",
          "type": "string"
        },
        "track": {
          "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
          "title": "Track",
          "type": "string"
        },
        "send": {
          "$ref": "#/$defs/Send"
        }
      },
      "required": [
        "track",
        "send"
      ],
      "title": "AddSend",
      "type": "object"
    },
    "AddTrack": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "add_track",
          "default": "add_track",
          "title": "Op",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "audio",
            "instrument",
            "bus",
            "return"
          ],
          "title": "Kind",
          "type": "string"
        },
        "output": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "master",
          "title": "Output"
        },
        "index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Index"
        }
      },
      "required": [
        "id",
        "name",
        "kind"
      ],
      "title": "AddTrack",
      "type": "object"
    },
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AssetKind"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "ext": {
          "pattern": "^\\.[a-z0-9]{1,8}$",
          "title": "Ext",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "sample_rate": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Rate"
        },
        "channels": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channels"
        },
        "frames": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frames"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "sha256",
        "kind",
        "name",
        "ext",
        "size_bytes",
        "provenance"
      ],
      "title": "Asset",
      "type": "object"
    },
    "AssetKind": {
      "enum": [
        "original",
        "working",
        "stem",
        "sample",
        "render",
        "midi",
        "preset",
        "plugin_state",
        "analysis"
      ],
      "title": "AssetKind",
      "type": "string"
    },
    "AudioClip": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "audio",
          "default": "audio",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "asset": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Asset",
          "type": "string"
        },
        "start_tick": {
          "minimum": 0,
          "title": "Start Tick",
          "type": "integer"
        },
        "source_offset": {
          "default": 0,
          "description": "muestra de inicio dentro del asset",
          "minimum": 0,
          "title": "Source Offset",
          "type": "integer"
        },
        "source_length": {
          "description": "muestras del asset que suenan",
          "exclusiveMinimum": 0,
          "title": "Source Length",
          "type": "integer"
        },
        "gain_db": {
          "default": 0.0,
          "title": "Gain Db",
          "type": "number"
        },
        "fade_in": {
          "default": 0,
          "description": "muestras",
          "minimum": 0,
          "title": "Fade In",
          "type": "integer"
        },
        "fade_out": {
          "default": 0,
          "description": "muestras",
          "minimum": 0,
          "title": "Fade Out",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "asset",
        "start_tick",
        "source_length"
      ],
      "title": "AudioClip",
      "type": "object"
    },
    "AutomationLane": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "track": {
          "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
          "title": "Track",
          "type": "string"
        },
        "target": {
          "description": "'gain_db', 'pan' o '<plugin_id>.<parámetro>'",
          "title": "Target",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/AutomationPoint"
          },
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "id",
        "track",
        "target",
        "points"
      ],
      "title": "AutomationLane",
      "type": "object"
    },
    "AutomationPoint": {
      "additionalProperties": false,
