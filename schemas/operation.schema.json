          "minimum": 0,
          "title": "Tick",
          "type": "integer"
        },
        "duration": {
          "exclusiveMinimum": 0,
          "title": "Duration",
          "type": "integer"
        },
        "pitch": {
          "maximum": 127,
          "minimum": 0,
          "title": "Pitch",
          "type": "integer"
        },
        "velocity": {
          "maximum": 127,
          "minimum": 1,
          "title": "Velocity",
          "type": "integer"
