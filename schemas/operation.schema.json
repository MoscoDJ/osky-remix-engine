          "type": "integer"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "curve": {
          "default": "linear",
          "enum": [
            "linear",
            "hold"
          ],
          "title": "Curve",
          "type": "string"
        }
      },
      "required": [
        "tick",
        "value"
      ],
      "title": "AutomationPoint",
      "type": "object"
    },
