    "Marker": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "tick": {
          "minimum": 0,
          "title": "Tick",
          "type": "integer"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "default": "section",
